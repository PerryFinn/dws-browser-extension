{
  "name": "dws-browser-extension",
  "displayName": "数字孪生交付助手",
  "version": "0.1.1",
  "description": "提效工具",
  "author": "chenpengfei@cvte.com",
  "scripts": {
    "dev": "conc \"tsr watch\" \"plasmo dev\"",
    "build-zip": "tsr generate && plasmo build -- --zip",
    "build": "tsx scripts/build-upload.ts",
    "package": "plasmo package",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-router": "^1.131.10",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.39.9",
    "framer-motion": "^12.23.12",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.539.0",
    "plasmo": "^0.90.5",
    "qss": "^3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-toastify": "^11.0.5",
    "react-use-measure": "^2.1.7",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@changesets/cli": "^2.29.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.6.2",
    "@tanstack/react-router-devtools": "^1.131.10",
    "@tanstack/router-cli": "^1.131.7",
    "@types/adm-zip": "^0.5.7",
    "@types/buffer-to-stream": "^1.0.3",
    "@types/chrome": "^0.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "@types/spark-md5": "^3.0.5",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "buffer-to-stream": "^1.0.0",
    "chalk": "^5.5.0",
    "concurrently": "^9.2.0",
    "daisyui": "^5.0.50",
    "form-data": "^4.0.4",
    "fs-extra": "^11.3.1",
    "md5-file": "^5.0.0",
    "pathe": "^2.0.3",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.4",
    "typescript": "5.9.2"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "storage",
      "unlimitedStorage",
      "scripting",
      "tabs",
      "notifications",
      "debugger",
      "contextMenus",
      "webRequest",
      "webNavigation",
      "downloads"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "src/templates/*/**"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "homepage": "https://dws.seewo.com/",
  "packageManager": "pnpm@9.14.4",
  "volta": {
    "node": "22.15.0",
    "pnpm": "9.14.4"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
