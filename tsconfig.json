{
  "extends": "./.wxt/tsconfig.json",
  "exclude": ["node_modules"],
  "include": [".wxt/**/*.d.ts", "./**/*.ts", "./**/*.tsx", "node_modules/@types", "assets/**/*", "./src/global.d.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "assets/*": ["./assets/*"]
    },
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "strictNullChecks": true,
    "resolveJsonModule": true
  }
}
