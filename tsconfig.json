{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules"],
  "include": ["./**/*.ts", "./**/*.tsx", "node_modules/@types", "assets/**/*", "./src/global.d.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "assets/*": ["./assets/*"]
    },
    "strictNullChecks": true,
    "baseUrl": "."
  }
}
